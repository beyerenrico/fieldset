{
    "description": "Third-party software that docker/app/Dockerfile adds to the app image on top of its FrankenPHP base and Debian's own packages: name, version, origin, source, license (SPDX) and where it lands (ADR 0071). tests/Unit/Docker/ImageBinariesTest.php keeps this list and the Dockerfile in step, the image contract journey checks every path in the built image, and scripts/check-licenses.php checks every license against the allow-list.",
    "binaries": [
        {
            "name": "docker",
            "component": "Docker CLI",
            "version": "29.9.1",
            "origin": "release",
            "source": "https://download.docker.com/linux/static/stable/",
            "license": "Apache-2.0",
            "paths": ["/usr/local/bin/docker"],
            "license_files": ["/usr/share/doc/docker-cli/LICENSE", "/usr/share/doc/docker-cli/NOTICE"]
        },
        {
            "name": "docker-compose",
            "component": "Docker Compose (CLI plugin)",
            "version": "5.6.0",
            "origin": "source",
            "source": "https://github.com/docker/compose.git",
            "commit": "42f48072bbf92ee9b0e43f9fdf2008d03546e7ca",
            "license": "Apache-2.0",
            "paths": ["/usr/local/lib/docker/cli-plugins/docker-compose"],
            "license_files": ["/usr/share/doc/docker-compose/LICENSE", "/usr/share/doc/docker-compose/NOTICE"]
        },
        {
            "name": "age",
            "component": "age, age-keygen and age-plugin-batchpass",
            "version": "1.3.2",
            "origin": "source",
            "source": "https://github.com/FiloSottile/age.git",
            "commit": "b74dce4cdbe35b5e5f66c06d9612b72f89028758",
            "license": "BSD-3-Clause",
            "paths": ["/usr/local/bin/age", "/usr/local/bin/age-keygen", "/usr/local/bin/age-plugin-batchpass"],
            "license_files": ["/usr/share/doc/age/LICENSE"]
        },
        {
            "name": "postgresql-client-16",
            "component": "PostgreSQL 16 client: pg_dump, pg_restore, psql",
            "version": "16",
            "origin": "apt",
            "source": "https://apt.postgresql.org/pub/repos/apt",
            "license": "PostgreSQL",
            "paths": ["/usr/lib/postgresql/16/bin/pg_dump", "/usr/lib/postgresql/16/bin/pg_restore", "/usr/lib/postgresql/16/bin/psql"],
            "license_files": ["/usr/share/doc/postgresql-client-16/copyright"]
        },
        {
            "name": "libpq5",
            "component": "libpq, a dependency of postgresql-client-16",
            "version": "PGDG current",
            "origin": "apt",
            "source": "https://apt.postgresql.org/pub/repos/apt",
            "license": "PostgreSQL",
            "paths": ["/usr/lib/*-linux-gnu/libpq.so.5"],
            "license_files": ["/usr/share/doc/libpq5/copyright"]
        },
        {
            "name": "postgresql-client-common",
            "component": "pg_wrapper, a dependency of postgresql-client-16",
            "version": "PGDG current",
            "origin": "apt",
            "source": "https://apt.postgresql.org/pub/repos/apt",
            "license": "GPL-2.0-or-later",
            "paths": ["/usr/share/postgresql-common/pg_wrapper"],
            "license_files": ["/usr/share/doc/postgresql-client-common/copyright"]
        },
        {
            "name": "phpredis",
            "component": "PHP extension redis (PECL), built by install-php-extensions",
            "version": "PECL stable",
            "origin": "pecl",
            "source": "https://pecl.php.net/package/redis",
            "license": "PHP-3.01",
            "paths": ["/usr/local/lib/php/extensions/*/redis.so"],
            "license_files": ["/usr/local/lib/php/doc/redis/LICENSE"]
        }
    ]
}
