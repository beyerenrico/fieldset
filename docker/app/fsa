#!/bin/sh
# fsa [flags] <command> [args…] runs `php artisan fsa:<command>`; without a command it lists them (KTD1, ADR 0065).
# - The first argument that is not a flag (or the value of a flag in value_flags: every value-taking option of the
#   fsa:* commands, kept in step by ImageContractTest) is the command; flags before it move after it, so
#   `fsa --json status` is `fsa:status --json` and `fsa --behind-proxy traefik install` is
#   `fsa:install --behind-proxy traefik`. `--flag=value` always works. Without a command, --json lists as JSON.
# - An unknown command exits 2 with an `unknown_command` error (the fsa JSON envelope on stdout with --json),
#   never Laravel's plain text. `commands` lists the fsa:* commands for users, `roles` the entry points of image
#   roles (the backup service); tests/Unit/Docker/ImageContractTest.php keeps both in step with the registered
#   commands.
# - Symfony's console answers a literal --version with the framework version before any command runs, so the
#   --version flag of `fsa install` (§7) and `fsa adopt` is passed on as --release, up to a literal -- (ADR 0072, 0087).
set -e
commands='adopt backup config demo doctor install login-link logs reset restore rollback status tunnel uninstall upgrade version'
roles='backup-daemon restore-prepare upgrade-child'
value_flags='--acme-ca --acme-ca-root-file --acme-email --app-key-file --behind-proxy --dir --domain --from-address
--from-backup --from-name --identity-file --identity-out --kind --lan-address --locale --lock-id --org --orphans
--owner-email --owner-name --passphrase-file --password-file --phone-https --port --proxy-network --release
--scratch --seal --secrets-file --since --smtp-encryption --smtp-host --smtp-port --smtp-username --source
--tail --test-to --to --trusted-proxy --url --version'

takes_value() {
	for flag in $value_flags; do
		[ "$flag" != "$1" ] || return 0
	done
	return 1
}

json_string() {
	printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')"
}

unknown_command() { # <command> <json: 0|1>
	hint="Available commands: $(printf '%s' "$commands" | sed 's/ /, /g'). Run fsa without arguments to list them; put flags after the command or write them as --flag=value."
	if [ "$2" = 1 ]; then
		printf '{"schema_version":1,"command":%s,"status":"failed","exit_code":2,"changed":false,"data":{},"secrets":[],"warnings":[],"errors":[{"code":"unknown_command","message":%s,"hint":%s,"retryable":false}]}\n' \
			"$(json_string "$1")" "$(json_string "Unknown fsa command: $1")" "$(json_string "$hint")"
	else
		printf 'fsa: unknown command: %s\n  Fix: %s\n' "$1" "$hint" >&2
	fi
	exit 2
}

# Pass 1: take the command out of the arguments; everything else keeps its order.
command='' found=0 json=0 ended=0 value=0
n=$#
while [ "$n" -gt 0 ]; do
	arg=$1
	shift
	n=$((n - 1))
	if [ "$value" = 1 ]; then
		value=0
	elif [ "$ended" = 0 ]; then
		case $arg in
		--) ended=1 ;;
		--json) json=1 ;;
		-*) [ "$found" = 1 ] || ! takes_value "$arg" || value=1 ;;
		*) if [ "$found" = 0 ]; then command=$arg found=1 && continue; fi ;;
		esac
	fi
	set -- "$@" "$arg"
done

if [ "$found" = 1 ]; then
	case $command in
	'' | *[!a-z0-9-]* | -*) unknown_command "$command" "$json" ;;
	esac
	case " $commands $roles " in
	*" $command "*) ;;
	*) unknown_command "$command" "$json" ;;
	esac
fi

# Pass 2: --json lists as JSON; `install` and `adopt` take --version as --release (both only up to a literal --).
n=$#
ended=0
while [ "$n" -gt 0 ]; do
	arg=$1
	shift
	n=$((n - 1))
	if [ "$ended" = 0 ]; then
		case "$found:$command:$arg" in
		*:--) ended=1 ;;
		0::--json) arg=--format=json ;;
		1:install:--version | 1:adopt:--version) arg=--release ;;
		1:install:--version=* | 1:adopt:--version=*) arg=--release=${arg#--version=} ;;
		esac
	fi
	set -- "$@" "$arg"
done

[ "$found" = 1 ] || exec php /var/www/html/artisan list fsa "$@"
exec php /var/www/html/artisan "fsa:$command" "$@"
