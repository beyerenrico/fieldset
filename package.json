{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "e2e": "PLAYWRIGHT_BROWSERS_PATH=storage/playwright playwright test",
        "licenses": "node scripts/check-licenses.mjs",
        "conformance:php": "vendor/bin/pest --group=conformance",
        "conformance:js": "npm run conformance -w packages/form-schema-js",
        "conformance": "npm run conformance:php && npm run conformance:js",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "workspaces": [
        "packages/form-schema-js"
    ]
}
