{
    "name": "@form-schema-app/field-app",
    "version": "0.2.0",
    "description": "Offline-first Field App (PWA) served at /app, plus the builder preview entry",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "vite",
        "dev:preview": "vite -c vite.preview.config.ts",
        "build": "npm run build:app && npm run build:preview",
        "build:app": "vite build",
        "build:preview": "vite build -c vite.preview.config.ts",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@form-schema-app/form-schema-js": "*",
        "@form-schema-app/form-schema-react": "*",
        "@radix-ui/react-slot": "1.5.0",
        "@tanstack/react-query": "5.104.3",
        "@tanstack/react-router": "1.170.44",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.58.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwind-merge": "3.7.0",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "^24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "msw": "3.0.3",
        "prettier": "^3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    }
}
