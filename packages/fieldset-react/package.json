{
    "name": "@fieldset/fieldset-react",
    "version": "1.0.0",
    "description": "React renderer for Form Schema Spec 1.0 definitions (Field App and builder preview)",
    "private": true,
    "type": "module",
    "license": "MIT",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./styles.css": "./src/styles/index.css"
    },
    "types": "./src/index.ts",
    "files": [
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@fieldset/fieldset-js": "*",
        "@tanstack/react-virtual": "3.14.21",
        "@types/markdown-it": "14.2.0",
        "markdown-it": "14.3.3",
        "signature_pad": "5.1.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "prettier": "^3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
