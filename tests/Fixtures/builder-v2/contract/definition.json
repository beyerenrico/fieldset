{
  "$schema": "https://localhost/spec/form-definition/1.0/meta-schema.json",
  "specVersion": "1.0.0",
  "key": "contract_form",
  "title": "Vertragsformular",
  "locale": "de-DE",
  "settings": {
    "layout": "wizard",
    "numbering": {
      "format": "CF-{YYYY}-{SEQ:5}",
      "reset": "yearly"
    }
  },
  "pages": [
    {
      "id": "0192f1c4-0000-7000-8000-00000000b001",
      "key": "start",
      "title": "Start",
      "elements": [
        {
          "id": "0192f1c4-0000-7000-8000-00000000b011",
          "type": "text",
          "key": "customer",
          "label": "Kunde",
          "required": true,
          "x-crm": {
            "field": "name"
          }
        },
        {
          "id": "0192f1c4-0000-7000-8000-00000000b012",
          "type": "section",
          "key": "details",
          "label": "Details",
          "elements": [
            {
              "id": "0192f1c4-0000-7000-8000-00000000b013",
              "type": "columns",
              "key": "cols",
              "columns": [
                {
                  "elements": [
                    {
                      "id": "0192f1c4-0000-7000-8000-00000000b014",
                      "type": "date",
                      "key": "day",
                      "label": "Tag"
                    }
                  ]
                },
                {
                  "elements": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "0192f1c4-0000-7000-8000-00000000b002",
      "key": "items_page",
      "title": "Positionen",
      "elements": [
        {
          "id": "0192f1c4-0000-7000-8000-00000000b021",
          "type": "repeater",
          "key": "items",
          "label": "Positionen",
          "elements": [
            {
              "id": "0192f1c4-0000-7000-8000-00000000b022",
              "type": "text",
              "key": "description",
              "label": "Beschreibung",
              "required": true
            },
            {
              "id": "0192f1c4-0000-7000-8000-00000000b023",
              "type": "number",
              "key": "qty",
              "label": "Menge"
            }
          ]
        }
      ]
    }
  ]
}
