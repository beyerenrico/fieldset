{
  "description": "Linter rules (spec §7)",
  "tests": [
    {
      "description": "clean definition has no findings",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "number",
                "key": "b",
                "label": "b",
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": []
    },
    {
      "description": "duplicate key in root scope (across a section)",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "section",
                "key": "s",
                "elements": [
                  {
                    "type": "text",
                    "key": "a",
                    "label": "a",
                    "id": "00000000-0000-4000-8000-000000000003"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "duplicate_key",
          "path": "/pages/0/elements/1/elements/0"
        }
      ]
    },
    {
      "description": "same key in repeater row and root is allowed",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "repeater",
                "key": "r",
                "label": "R",
                "elements": [
                  {
                    "type": "text",
                    "key": "a",
                    "label": "a",
                    "id": "00000000-0000-4000-8000-000000000003"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": []
    },
    {
      "description": "duplicate key across pages",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p1",
            "title": "P1",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          },
          {
            "key": "p2",
            "title": "P2",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "duplicate_key",
          "path": "/pages/1/elements/0"
        }
      ]
    },
    {
      "description": "duplicate page key",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          },
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "b",
                "label": "b",
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "duplicate_page_key",
          "path": "/pages/1"
        }
      ]
    },
    {
      "description": "duplicate option value",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "select",
                "key": "s",
                "label": "S",
                "options": [
                  {
                    "value": "a",
                    "label": "A"
                  },
                  {
                    "value": "a",
                    "label": "B"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "duplicate_option_value",
          "path": "/pages/0/elements/0/options/1"
        }
      ]
    },
    {
      "description": "unknown var reference",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "visibleIf": {
                  "==": [
                    {
                      "var": "nope"
                    },
                    "x"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_reference",
          "path": "/pages/0/elements/0/visibleIf"
        }
      ]
    },
    {
      "description": "built-ins and dotted paths resolve",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "default": {
                  "cat": [
                    {
                      "var": "$user.name"
                    },
                    {
                      "var": "$org.name"
                    },
                    {
                      "var": "$form.version"
                    },
                    {
                      "var": "$today"
                    },
                    {
                      "var": "$now"
                    }
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "signature",
                "key": "sig",
                "label": "Sig",
                "id": "00000000-0000-4000-8000-000000000002"
              },
              {
                "type": "text",
                "key": "b",
                "label": "b",
                "visibleIf": {
                  "var": "sig.signerName"
                },
                "id": "00000000-0000-4000-8000-000000000003"
              }
            ]
          }
        ]
      },
      "expected": []
    },
    {
      "description": "$root reference must exist at root",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "repeater",
                "key": "r",
                "label": "R",
                "elements": [
                  {
                    "type": "text",
                    "key": "x",
                    "label": "x",
                    "visibleIf": {
                      "var": "$root.missing"
                    },
                    "id": "00000000-0000-4000-8000-000000000002"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_reference",
          "path": "/pages/0/elements/0/elements/0/visibleIf"
        }
      ]
    },
    {
      "description": "row keys are not visible at root",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "repeater",
                "key": "r",
                "label": "R",
                "elements": [
                  {
                    "type": "text",
                    "key": "x",
                    "label": "x",
                    "id": "00000000-0000-4000-8000-000000000002"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "text",
                "key": "y",
                "label": "y",
                "visibleIf": {
                  "var": "x"
                },
                "id": "00000000-0000-4000-8000-000000000003"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_reference",
          "path": "/pages/0/elements/1/visibleIf"
        }
      ]
    },
    {
      "description": "iteration operators scope var to the item",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "repeater",
                "key": "r",
                "label": "R",
                "elements": [
                  {
                    "type": "text",
                    "key": "status",
                    "label": "status",
                    "id": "00000000-0000-4000-8000-000000000002"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "text",
                "key": "any_failed",
                "label": "any_failed",
                "visibleIf": {
                  "some": [
                    {
                      "var": "r"
                    },
                    {
                      "==": [
                        {
                          "var": "status"
                        },
                        "failed"
                      ]
                    }
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000003"
              }
            ]
          }
        ]
      },
      "expected": []
    },
    {
      "description": "signerNameFrom must reference a key",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "signature",
                "key": "sig",
                "label": "S",
                "signerNameFrom": "nobody",
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_reference",
          "path": "/pages/0/elements/0/signerNameFrom"
        }
      ]
    },
    {
      "description": "sum row key must exist in the repeater",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "repeater",
                "key": "r",
                "label": "R",
                "elements": [
                  {
                    "type": "number",
                    "key": "q",
                    "label": "q",
                    "id": "00000000-0000-4000-8000-000000000002"
                  }
                ],
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "calculated",
                "key": "t",
                "label": "T",
                "expression": {
                  "sum": [
                    {
                      "var": "r"
                    },
                    "nope"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000003"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_reference",
          "path": "/pages/0/elements/1/expression"
        }
      ]
    },
    {
      "description": "unknown operator",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "visibleIf": {
                  "regex": [
                    "x",
                    "y"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "unknown_operator",
          "path": "/pages/0/elements/0/visibleIf"
        }
      ]
    },
    {
      "description": "builtin comparison on a number field",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "number",
                "key": "q",
                "label": "q",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "visibleIf": {
                  ">": [
                    {
                      "var": "q"
                    },
                    5
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "decimal_builtin_operator",
          "path": "/pages/0/elements/1/visibleIf"
        }
      ]
    },
    {
      "description": "builtin arithmetic on money",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "money",
                "key": "p",
                "label": "P",
                "currency": "EUR",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "calculated",
                "key": "t",
                "label": "T",
                "expression": {
                  "*": [
                    {
                      "var": "p"
                    },
                    2
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "decimal_builtin_operator",
          "path": "/pages/0/elements/1/expression"
        }
      ]
    },
    {
      "description": "builtin equality on a numeric calculated value",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "number",
                "key": "q",
                "label": "q",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "calculated",
                "key": "c",
                "label": "C",
                "expression": {
                  "dec.add": [
                    {
                      "var": "q"
                    },
                    "1"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000002"
              },
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "visibleIf": {
                  "==": [
                    {
                      "var": "c"
                    },
                    "2"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000003"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "decimal_builtin_operator",
          "path": "/pages/0/elements/2/visibleIf"
        }
      ]
    },
    {
      "description": "builtin comparison on text calculated values is fine",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "calculated",
                "key": "c",
                "label": "C",
                "format": "text",
                "expression": "x",
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "text",
                "key": "a",
                "label": "a",
                "visibleIf": {
                  "==": [
                    {
                      "var": "c"
                    },
                    "x"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": []
    },
    {
      "description": "decimal operators on numbers are fine",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
