    {
      "description": "cycle between calculated elements",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "lint_case",
        "title": "Lint Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "calculated",
                "key": "a",
                "label": "A",
                "expression": {
                  "dec.add": [
                    {
                      "var": "b"
                    },
                    "1"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000001"
              },
              {
                "type": "calculated",
                "key": "b",
                "label": "B",
                "expression": {
                  "dec.add": [
                    {
                      "var": "a"
                    },
                    "1"
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        ]
      },
      "expected": [
