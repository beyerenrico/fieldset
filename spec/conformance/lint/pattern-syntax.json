{
  "description": "invalid_pattern follows the restricted ECMAScript subset (spec §3.4)",
  "tests": [
    {
      "description": "inline flags (?i) is invalid",
      "definition": {
        "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
        "specVersion": "1.0.0",
        "key": "pattern_case",
        "title": "Pattern Case",
        "locale": "de-DE",
        "pages": [
          {
            "key": "p",
            "title": "P",
            "elements": [
              {
                "type": "text",
                "key": "t",
                "label": "T",
                "validation": {
                  "pattern": "(?i)abc"
                },
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "severity": "error",
          "code": "invalid_pattern",
          "path": "/pages/0/elements/0/validation/pattern"
        }
      ]
    },
