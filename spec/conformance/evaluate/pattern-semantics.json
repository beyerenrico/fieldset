{
  "description": "pattern semantics: ECMAScript u-mode, ASCII classes, JS whitespace (spec §3.4)",
  "definition": {
    "$schema": "https://beyerenrico.github.io/fieldset/spec/form-definition/1.0/meta-schema.json",
    "specVersion": "1.0.0",
    "key": "pattern_semantics",
    "title": "Pattern Semantics",
    "locale": "de-DE",
    "pages": [
      {
        "key": "p",
        "title": "P",
        "elements": [
          {
            "type": "text",
            "key": "digit",
            "label": "D",
            "validation": {
              "pattern": "^\\d$"
            },
            "id": "00000000-0000-4000-8000-000000000001"
          },
          {
            "type": "text",
            "key": "word",
            "label": "W",
            "validation": {
              "pattern": "^\\w+$"
            },
            "id": "00000000-0000-4000-8000-000000000002"
          },
          {
            "type": "text",
            "key": "space",
            "label": "S",
            "validation": {
              "pattern": "^\\s$"
            },
            "id": "00000000-0000-4000-8000-000000000003"
          },
          {
            "type": "text",
            "key": "bound",
            "label": "B",
            "validation": {
              "pattern": "a\\b"
            },
            "id": "00000000-0000-4000-8000-000000000004"
          },
          {
            "type": "text",
            "key": "dot",
            "label": "Dot",
            "validation": {
              "pattern": "^.$"
            },
            "id": "00000000-0000-4000-8000-000000000005"
          },
          {
            "type": "text",
            "key": "anchor",
            "label": "A",
            "validation": {
              "pattern": "^a$"
            },
            "id": "00000000-0000-4000-8000-000000000006"
          },
          {
            "type": "text",
            "key": "contains",
            "label": "C",
            "validation": {
              "pattern": "b"
            },
            "id": "00000000-0000-4000-8000-000000000007"
          },
          {
            "type": "textarea",
            "key": "long",
            "label": "L",
            "validation": {
              "pattern": "a"
            },
            "id": "00000000-0000-4000-8000-000000000008"
          },
          {
            "type": "text",
            "key": "case",
            "label": "Case",
            "validation": {
              "pattern": "^abc$"
            },
            "id": "00000000-0000-4000-8000-000000000009"
          },
          {
            "type": "text",
            "key": "astral",
            "label": "Astral",
            "validation": {
              "pattern": "^[\\u{1F600}-\\u{1F64F}]$"
            },
            "id": "00000000-0000-4000-8000-000000000010"
          }
        ]
      }
    ]
  },
  "context": {
    "today": "2026-10-16",
    "now": "2026-10-16T09:41:00+02:00",
    "user": {
      "name": "Willi Worker",
      "email": "worker@demo.test"
    },
    "org": {
      "name": "Demo GmbH"
    },
    "formVersion": 3
  },
  "tests": [
    {
      "description": "\\d is ASCII only",
      "data": {
        "digit": "٣"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/digit",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "\\d matches 7",
      "data": {
        "digit": "7"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "\\w is ASCII only",
      "data": {
        "word": "é"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/word",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "\\w matches letters digits underscore",
      "data": {
        "word": "aZ_9"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "\\s excludes U+0085",
      "data": {
        "space": ""
      },
      "expected": {
        "errors": [
          {
            "pointer": "/space",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "\\s excludes U+180E",
      "data": {
        "space": "᠎"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/space",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "\\s includes U+3000",
      "data": {
        "space": "　"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "\\s includes U+FEFF",
      "data": {
        "space": "﻿"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "\\b between a and é",
      "data": {
        "bound": "aé"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": ". matches one astral code point",
      "data": {
        "dot": "😀"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": ". does not match a newline",
      "data": {
        "dot": "\n"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/dot",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "$ does not match before a trailing newline",
      "data": {
        "anchor": "a\n"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/anchor",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "patterns are unanchored",
      "data": {
        "contains": "abc"
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "4096 code points are checked",
      "data": {
        "long": ""
      },
      "expected": {
        "errors": []
      }
    },
    {
      "description": "4097 code points fail closed",
      "data": {
        "long": ""
      },
      "expected": {
        "errors": [
          {
            "pointer": "/long",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "matching is case-sensitive",
      "data": {
        "case": "ABC"
      },
      "expected": {
        "errors": [
          {
            "pointer": "/case",
            "code": "pattern"
          }
        ]
      }
    },
    {
      "description": "astral ranges work on code points",
      "data": {
        "astral": "😃"
      },
      "expected": {
        "errors": []
      }
    }
  ]
}
