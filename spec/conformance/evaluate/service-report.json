{
  "description": "The BUILD_PROMPT §7.2 service report",
  "definition": {
    "$schema": "https://localhost/spec/form-definition/1.0/meta-schema.json",
    "specVersion": "1.0.0",
    "key": "service_report",
    "title": "Service Report",
    "locale": "de-DE",
    "pages": [
      {
        "key": "job",
        "title": "Job",
        "elements": [
          {
            "type": "text",
            "key": "customer_name",
            "label": "Customer",
            "required": true,
            "validation": {
              "maxLength": 120
            },
            "role": "customer.name",
            "id": "00000000-0000-4000-8000-000000000001"
          },
          {
            "type": "date",
            "key": "service_date",
            "label": "Service date",
            "default": {
              "var": "$today"
            },
            "id": "00000000-0000-4000-8000-000000000002"
          },
          {
            "type": "select",
            "key": "service_type",
            "label": "Service type",
            "required": true,
            "options": [
              {
                "value": "maintenance",
                "label": "Maintenance"
              },
              {
                "value": "repair",
                "label": "Repair"
              }
            ],
            "id": "00000000-0000-4000-8000-000000000003"
          },
          {
            "type": "textarea",
            "key": "defect",
            "label": "Defect description",
            "required": true,
            "visibleIf": {
              "==": [
                {
                  "var": "service_type"
                },
                "repair"
              ]
            },
            "id": "00000000-0000-4000-8000-000000000004"
          }
        ]
      },
      {
        "key": "work",
        "title": "Work",
        "elements": [
          {
            "type": "repeater",
            "key": "items",
            "label": "Material & labour",
            "display": "table",
            "minItems": 1,
            "addLabel": "Add line",
            "elements": [
              {
                "type": "text",
                "key": "description",
                "label": "Description",
                "required": true,
                "id": "00000000-0000-4000-8000-000000000006"
              },
              {
                "type": "number",
                "key": "qty",
                "label": "Qty",
                "validation": {
                  "min": 0,
                  "step": 0.25
                },
                "id": "00000000-0000-4000-8000-000000000007"
              },
              {
                "type": "money",
                "key": "unit_price",
                "label": "Unit price",
                "currency": "EUR",
                "id": "00000000-0000-4000-8000-000000000008"
              },
              {
                "type": "calculated",
                "key": "line_total",
                "label": "Total",
                "format": "money",
                "expression": {
                  "dec.mul": [
                    {
                      "var": "qty"
                    },
                    {
                      "var": "unit_price"
                    }
                  ]
                },
                "id": "00000000-0000-4000-8000-000000000009"
              }
            ],
            "id": "00000000-0000-4000-8000-000000000005"
          },
          {
            "type": "calculated",
            "key": "net_total",
            "label": "Net total",
            "format": "money",
            "expression": {
              "sum": [
                {
                  "var": "items"
                },
                "line_total"
              ]
            },
            "id": "00000000-0000-4000-8000-000000000010"
          },
          {
            "type": "calculated",
            "key": "vat",
            "label": "VAT 19 %",
            "format": "money",
            "expression": {
              "dec.round": [
                {
                  "dec.mul": [
                    {
                      "var": "net_total"
                    },
                    "0.19"
                  ]
                },
                2
              ]
            },
            "id": "00000000-0000-4000-8000-000000000011"
          },
          {
            "type": "photo",
            "key": "photos",
            "label": "Photos",
            "multiple": true,
            "validation": {
              "maxFiles": 20,
              "maxSizeKb": 8192
            },
            "id": "00000000-0000-4000-8000-000000000012"
          },
          {
            "type": "signature",
            "key": "customer_signature",
            "label": "Customer signature",
            "required": true,
            "signerNameFrom": "customer_name",
            "id": "00000000-0000-4000-8000-000000000013"
          }
        ]
      }
    ],
    "settings": {
      "layout": "wizard",
      "numbering": {
        "format": "SR-{YYYY}-{SEQ:5}",
        "reset": "yearly"
      },
      "document": {
        "design": "default"
      }
    }
  },
  "context": {
    "today": "2026-10-16",
    "now": "2026-10-16T09:41:00+02:00",
    "user": {
      "name": "Willi Worker",
      "email": "worker@demo.test"
    },
    "org": {
      "name": "Demo GmbH"
    },
    "formVersion": 3
  },
