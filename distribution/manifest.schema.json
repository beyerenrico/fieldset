{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/beyerenrico/fieldset/main/distribution/manifest.schema.json",
    "title": "Fieldset release manifest",
    "description": "Pins every image of a release by digest and lists asset checksums (BUILD_PROMPT_V2 R2, R4; ADR 0060, 0067). Signed with cosign sign-blob --bundle; it carries no signer identity, which install.sh and the image hold (R58). Readers ignore unknown keys; an incompatible change raises schema_version.",
    "type": "object",
    "required": [
        "schema_version",
        "version",
        "channel",
        "notes_url",
        "upgrades_from",
        "platforms",
        "images",
        "assets"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "version": {
            "$ref": "#/$defs/version",
            "description": "The release version, X.Y.Z or X.Y.Z-alpha|beta|rc.N."
        },
        "channel": {
            "enum": [
                "stable",
                "alpha",
                "beta",
                "rc"
            ],
            "description": "Derived from the version: stable releases move X.Y, X and latest; pre-releases publish only their own tag."
        },
        "notes_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "Release notes."
        },
        "upgrades_from": {
            "$ref": "#/$defs/version",
            "description": "The oldest version this release upgrades from; older instances and backups are refused."
        },
        "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "linux/amd64",
                    "linux/arm64"
                ]
            },
            "description": "Platforms every image carries."
        },
        "images": {
            "type": "object",
            "description": "Service name => image. Installs pull <registry or FIELDSET_REGISTRY>/<repository>@<digest>, never a tag.",
            "required": [
                "app",
                "postgres",
                "valkey",
                "gotenberg",
                "mailpit",
                "caddy",
                "cloudflared"
            ],
            "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/image"
            }
        },
        "assets": {
            "type": "object",
            "description": "Release asset file name => checksum (install.sh, shim.sh, compose.stack.yaml, ...). compose.stack.yaml (R18, ADR 0076) is rendered from the images below and runs only them; manifests before 2.0.0-alpha.2 lack it, so readers do not require it.",
            "required": [
                "install.sh",
                "shim.sh"
            ],
            "propertyNames": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "additionalProperties": {
                "type": "object",
                "required": [
                    "sha256",
                    "size"
                ],
                "properties": {
                    "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            }
        }
    },
    "$defs": {
        "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:alpha|beta|rc)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "image": {
            "type": "object",
            "required": [
                "registry",
                "repository",
                "tag",
                "digest",
                "platforms"
            ],
            "properties": {
                "registry": {
                    "type": "string",
                    "pattern": "^(?:localhost|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+|\\d{1,3}(?:\\.\\d{1,3}){3})(?::\\d{1,5})?$"
                },
                "repository": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
                },
                "tag": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
                    "description": "Informational; the digest decides."
                },
                "digest": {
                    "$ref": "#/$defs/digest",
                    "description": "Digest of the multi-platform image index."
                },
                "platforms": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                        "enum": [
                            "linux/amd64",
                            "linux/arm64"
                        ]
                    },
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "digest",
                            "compressed_size"
                        ],
                        "properties": {
                            "digest": {
                                "$ref": "#/$defs/digest"
                            },
                            "compressed_size": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Bytes of config and layers as pulled (compressed)."
                            }
                        }
                    }
                }
            }
        }
    }
}
