# Allow-list (ADR 0065): the build context holds only what docker/app/Dockerfile's stages read.
# Tests, docs, scripts, CI config, agent files, local storage, vendor and node_modules never reach the builder.
*

!app/
!artisan
!bootstrap/app.php
!bootstrap/providers.php
!bootstrap/cache/.gitignore
!composer.json
!composer.lock
!config/
!database/
!distribution/manifest.schema.json
!distribution/shim.sh
!docker/app/
!lang/
!LICENSE
!package.json
!package-lock.json
!packages/
!public/
!resources/
!routes/
!spec/LICENSE
!spec/form-definition/
!spec/templates/
!storage/**/.gitignore
!vite.config.js

# Re-excluded inside allowed directories: dependencies, test suites, coverage and host-built assets.
**/node_modules
**/coverage
**/.DS_Store
packages/*/test
packages/*/tests
resources/*/test
public/app
public/build
public/form-preview
public/hot
public/storage
public/css/filament
public/js/filament
public/fonts/filament
