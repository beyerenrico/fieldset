{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "form-schema-app/app",
    "type": "project",
    "description": "Open-source, self-hostable form schema application",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.4",
        "brick/math": "^1.0",
        "dedoc/scramble": "^0.13.48",
        "filament/filament": "^5.10",
        "firebase/php-jwt": "^7.2",
        "form-schema/form-schema-php": "@dev",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "litesaml/lightsaml": "^4.7.2",
        "opis/json-schema": "^2.6",
        "predis/predis": "^3.7",
        "pxlrbt/filament-activity-log": "^3.1.2",
        "socialiteproviders/openidconnect": "^1.0.1",
        "socialiteproviders/saml2": "^4.10",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "FormSchema\\": "packages/form-schema-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "vendor/bin/pint --test",
            "vendor/bin/rector --dry-run --no-progress-bar"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
            "vendor/bin/phpstan analyse -c phpstan-schema.neon --memory-limit=1G --no-progress"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore-abandoned": {
                "symplify/rule-doc-generator-contracts": "Dev only: interfaces required by driftingly/rector-laravel 2.6.2 (the latest); no code of it runs in the app. Security advisories still fail the audit."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/form-schema-php",
            "options": {
                "symlink": true
            }
        }
    ]
}
