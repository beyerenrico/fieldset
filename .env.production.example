# Production template (docs/guide/install.md). Copy to .env, set APP_KEY (php artisan key:generate),
# the passwords, APP_URL, mail and TRUSTED_PROXIES. Never use .env.example (development) in production.

APP_NAME=form-schema-app
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://forms.example.com
APP_PORT=8080
# Self-service organization registration on /admin (ADR 0004). Off by default; enable only for a
# public instance. Use `php artisan app:install` for the first organization.
APP_ALLOW_REGISTRATION=false
# API documentation (/docs/api): comma-separated emails. Horizon needs a platform operator signed in at /platform.
PLATFORM_ADMIN_EMAILS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Production uses compose.yaml only (no published database ports, no Mailpit, no test databases).
COMPOSE_FILE=compose.yaml

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=form_schema
DB_USERNAME=form_schema
DB_PASSWORD=change-me-to-a-long-random-password

# Field App sessions must outlive offline periods (BUILD_PROMPT §9.3): 30 days, rolling.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS requests always get Secure session/XSRF cookies (ADR 0040); this only affects plain http.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=forms.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="forms@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOTENBERG_URL=http://gotenberg:3000

# Fillable PDF import (ADR 0024). qpdf lives in the app image; hosts without qpdf can use the
# Docker wrapper scripts/qpdf (relative paths resolve against the project root).
QPDF_BINARY=qpdf

VITE_APP_NAME="${APP_NAME}"

# Mail delivery (M3, config/messaging.php). Allow private SMTP hosts only in development (Mailpit).
MESSAGING_ATTACHMENT_MAX_BYTES=10485760
MESSAGING_LINK_TTL_DAYS=14
MESSAGING_SMTP_ALLOW_PRIVATE_HOSTS=false

# SSO (M7, config/sso.php). Insecure IdPs (http, private hosts) only for Docker Keycloak in dev/CI.
# SSO_DNS_DRIVER: dns (production) or config (records from SSO_DNS_RECORDS, a JSON object name => [values]).
SSO_ALLOW_INSECURE_IDP=false
SSO_DNS_DRIVER=dns
SSO_DNS_RECORDS=
SSO_SAML_SP_CERTIFICATE=
SSO_SAML_SP_PRIVATE_KEY=

# Security (M8, config/security.php, config/trustedproxy.php; ADR 0040). TRUSTED_PROXIES: IPs/CIDRs of
# the TLS-terminating reverse proxy. compose.yaml publishes the app on 127.0.0.1 only, so a proxy on the
# host arrives from the Docker bridge gateway (172.16.0.0/12). Narrow it to your proxy's address; never
# trust a range that untrusted clients can reach directly.
TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_HOSTS=
SECURITY_HSTS_ENABLED=
# Admin panel sessions: idle and absolute timeouts (the Field App keeps SESSION_LIFETIME).
SECURITY_ADMIN_IDLE_MINUTES=30
SECURITY_ADMIN_ABSOLUTE_HOURS=12

# Optional malware scanning of uploads (config/uploads.php).
UPLOADS_CLAMAV_ENABLED=false
UPLOADS_CLAMAV_HOST=clamav
UPLOADS_CLAMAV_PORT=3310

# Error reporting to a Sentry-compatible endpoint: add `sentry` to LOG_STACK.
SENTRY_DSN=

# /platform operator panel (config/platform.php; ADR 0041).
PLATFORM_IMPERSONATION_MINUTES=30
PLATFORM_SESSION_HOURS=12

# Integration tokens (config/api_tokens.php; ADR 0043): preselected expiry in days.
API_TOKEN_DEFAULT_EXPIRY_DAYS=90

# Audit log and privacy (config/audit.php, config/privacy.php; ADR 0038, 0039).
AUDIT_RETENTION_DAYS=365
PRIVACY_LEGAL_HOLD_MIN_MONTHS=120
PRIVACY_EXPORT_KEEP_DAYS=7
